# Copy to .env and fill in locally. .env is git-ignored: never commit real values.

# ── Kernel ──
# Where the Undo / Audit Ledger lives. Default: ~/.kiko
KIKO_DATA_DIR=
# Policy file. Default: schemas/policy_tiers.json
KIKO_POLICY_PATH=

# ── AWS async relay ──
# Credentials come from the standard AWS chain (aws sso login / named profile), never from this file.
AWS_REGION=
AWS_PROFILE=
KIKO_RELAY_TARGET_ARN=
KIKO_RELAY_ROLE_ARN=

# ── HUD voice (read by client_hud) ──
ELEVENLABS_API_KEY=
